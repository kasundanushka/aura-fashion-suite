# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration
DATABASE_PATH=database/clothing.db

# Model & Optimization Hyperparameters
FORECAST_HORIZON_WEEKS=8
SAFETY_STOCK_SERVICE_FACTOR=1.65
DEFAULT_LEAD_TIME_DAYS=7
HRVITON_TIMEOUT=120
HR_VITON_DIR=/path/to/HR-VITON
TOCG_CKPT=/path/to/checkpoints/condition_stage/tocg_final.pth
GEN_CKPT=/path/to/checkpoints/generator_stage/gen_step_006000.pth
WORK_DIR=/tmp/tryon_jobs
HR_VITON_MOCK_PREPROCESS=false

# IDM-VTON Gradio Client (Diffusion model on HuggingFace or Colab URL)
IDM_VTON_ENABLED=true
IDM_VTON_SPACE=yisol/IDM-VTON
IDM_VTON_TIMEOUT=180
